							"fieldInstances": [
								{ "__identifier": "sprite", "__type": "Int", "__value": 133, "__tile": null, "defUid": 31, "realEditorValues": [{ "id": "V_Int", "params": [133] }] },
								{ "__identifier": "dialog", "__type": "Multilines", "__value": "[\n  {\n    \"pre_eval\": \"console.log('1');\",\n    \"text\": \"Hi Sarah!  A large metal object fell out of the sky to the east of here a few minutes ago, and we've decided that you're the one who gets to go and investigage.  You should go see if anyone needs help.\",\n    \"post_eval\": \"window.Flags.start = 1;\"\n  },\n  {\n    \"condition\": \"window.Flag('start') == 1\",\n    \"pre_eval\": \"console.log('2');\",\n    \"text\": \"Why you?  We voted.  If you wanted to vote, you should have been there.\",\n    \"post_eval\": \"window.Flags.start = 2\"\n  },\n  {\n    \"condition\": \"window.Flag('start') == 2\",\n    \"pre_eval\": \"console.log('3');\",\n    \"text\": \"Go on.  Go to the west and investigate, and try not to die!\"\n  }\n]", "__tile": null, "defUid": 32, "realEditorValues": [{
									"id": "V_String",
									"params": [
										"[\\n  {\\n    \"pre_eval\": \"console.log('1');\",\\n    \"text\": \"Hi Sarah!  A large metal object fell out of the sky to the east of here a few minutes ago, and we've decided that you're the one who gets to go and investigage.  You should go see if anyone needs help.\",\\n    \"post_eval\": \"window.Flags.start = 1;\"\\n  },\\n  {\\n    \"condition\": \"window.Flag('start') == 1\",\\n    \"pre_eval\": \"console.log('2');\",\\n    \"text\": \"Why you?  We voted.  If you wanted to vote, you should have been there.\",\\n    \"post_eval\": \"window.Flags.start = 2\"\\n  },\\n  {\\n    \"condition\": \"window.Flag('start') == 2\",\\n    \"pre_eval\": \"console.log('3');\",\\n    \"text\": \"Go on.  Go to the west and investigate, and try not to die!\"\\n  }\\n]"
									]
								}] }
							],
