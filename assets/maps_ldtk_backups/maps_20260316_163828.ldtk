						{
							"__identifier": "Npc",
							"__grid": [11,13],
							"__pivot": [0,0],
							"__tags": [],
							"__tile": { "tilesetUid": 5, "x": 0, "y": 16, "w": 8, "h": 8 },
							"__smartColor": "#B9F1A2",
							"iid": "00000000-0000-4000-8000-000000000084",
							"width": 8,
							"height": 8,
							"defUid": 33,
							"px": [88,104],
							"fieldInstances": [
								{ "__identifier": "sprite", "__type": "Int", "__value": 129, "__tile": null, "defUid": 31, "realEditorValues": [{ "id": "V_Int", "params": [129] }] },
								{ "__identifier": "dialog", "__type": "Multilines", "__value": "[\n  {\n    \"text\": \"Someone sabotaged our ship and we crashlanded here on this strange planet..  We thought maybe it was Lime, so we tossed 'em out the airlock, but the stabotage continued.  Poor ${'Lime'}...\"\n  }\n]", "__tile": null, "defUid": 32, "realEditorValues": [{
									"id": "V_String",
									"params": [
										"[\\n  {\\n    \"text\": \"Someone sabotaged our ship and we crashlanded here on this strange planet..  We thought maybe it was Lime, so we tossed 'em out the airlock, but the stabotage continued.  Poor ${'Lime'}...\"\\n  }\\n]"
									]
								}] }
							],
							"__worldX": -192,
							"__worldY": 480
						},
						{
							"__identifier": "Npc",
							"__grid": [15,13],
							"__pivot": [0,0],
							"__tags": [],
							"__tile": { "tilesetUid": 5, "x": 0, "y": 16, "w": 8, "h": 8 },
							"__smartColor": "#B9F1A2",
							"iid": "00000000-0000-4000-8000-000000000085",
							"width": 8,
							"height": 8,
							"defUid": 33,
							"px": [120,104],
							"fieldInstances": [
								{ "__identifier": "sprite", "__type": "Int", "__value": 130, "__tile": null, "defUid": 31, "realEditorValues": [{ "id": "V_Int", "params": [130] }] },
								{ "__identifier": "dialog", "__type": "Multilines", "__value": "[\n  {\n    \"text\": \"I caught Red sabotaging the navigation system just before we crashed.\"\n  }\n]", "__tile": null, "defUid": 32, "realEditorValues": [{
									"id": "V_String",
									"params": [
										"[\\n  {\\n    \"text\": \"I caught Red sabotaging the navigation system just before we crashed.\"\\n  }\\n]"
