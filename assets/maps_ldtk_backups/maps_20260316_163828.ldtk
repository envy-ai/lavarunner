						},
						{
							"__identifier": "Npc",
							"__grid": [17,13],
							"__pivot": [0,0],
							"__tags": [],
							"__tile": { "tilesetUid": 5, "x": 0, "y": 16, "w": 8, "h": 8 },
							"__smartColor": "#B9F1A2",
							"iid": "00000000-0000-4000-8000-000000000086",
							"width": 8,
							"height": 8,
							"defUid": 33,
							"px": [136,104],
							"fieldInstances": [
								{ "__identifier": "sprite", "__type": "Int", "__value": 131, "__tile": null, "defUid": 31, "realEditorValues": [{ "id": "V_Int", "params": [131] }] },
								{ "__identifier": "dialog", "__type": "Multilines", "__value": "[\n  {\n    \"text\": \"Maybe you can help us get off this planet...  We need a Big Bolt, Titanium Ore, and a Dilithium Crystal.\",\n    \"post_eval\": \"window.Flags.maguffins = 1;\"\n  },\n  {\n    \"condition\": \"window.Flag('maguffins') == 1\",\n    \"text\": \"We still need: ${Scripts.MaguffinList()}\"\n  },\n  {\n    \"condition\": \"window.Scripts.PlayerHasMaguffins()\",\n    \"text\": \"You've got all of the parts for our ship.  Thanks to you, we can get off this rock!\",\n    \"post_eval\": \"Scripts.Ending();\"\n  }\n]", "__tile": null, "defUid": 32, "realEditorValues": [{
									"id": "V_String",
									"params": [
										"[\\n  {\\n    \"text\": \"Maybe you can help us get off this planet...  We need a Big Bolt, Titanium Ore, and a Dilithium Crystal.\",\\n    \"post_eval\": \"window.Flags.maguffins = 1;\"\\n  },\\n  {\\n    \"condition\": \"window.Flag('maguffins') == 1\",\\n    \"text\": \"We still need: ${Scripts.MaguffinList()}\"\\n  },\\n  {\\n    \"condition\": \"window.Scripts.PlayerHasMaguffins()\",\\n    \"text\": \"You've got all of the parts for our ship.  Thanks to you, we can get off this rock!\",\\n    \"post_eval\": \"Scripts.Ending();\"\\n  }\\n]"
									]
								}] }
							],
